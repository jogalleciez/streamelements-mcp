# Copy to .env for local runs: node --env-file=.env build/index.js
# MCP clients (Claude Code/Desktop) pass these through their own config instead.

# One of these is required. JWT: StreamElements dashboard → account → Channels → "Show secrets".
SE_JWT_TOKEN=
# SE_OAUTH_TOKEN=

# Optional: 24-char hex channel id. Looked up via /channels/me when unset.
# SE_CHANNEL_ID=

# Optional: comma-separated toolsets, or "all" (default).
# activities, bot, commands, timers, filters, channels, chatstats, contests,
# giveaways, loyalty, overlays, sessions, songrequests, store, themes, tips
# SE_TOOLSETS=all

# Optional: true loads only read-only tools.
# SE_READ_ONLY=false

# Optional tuning.
# SE_TIMEOUT_MS=15000
# SE_MAX_RESPONSE_CHARS=100000
