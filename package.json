{
  "name": "streamelements-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the full StreamElements REST API (bot, loyalty, store, tips, song requests, contests, giveaways, and more)",
  "type": "module",
  "bin": {
    "streamelements-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "start": "node build/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "keywords": [
    "mcp",
    "streamelements",
    "twitch",
    "streaming"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
